# =============================================================
# PDS.ushuaia · Variables de entorno (plantilla)
# Copiar a .env.local y completar. NO commitear .env.local.
# En producción, cargar TODAS estas en Vercel (Project → Settings → Env).
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (nunca exponer en el cliente):
SUPABASE_SERVICE_ROLE_KEY=

# --- App / URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Usada por push/back_urls; en prod, la URL de Vercel / dominio.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=            # SECRETA
VAPID_SUBJECT=mailto:pds.ushuaia@gmail.com

# --- Cron de recordatorios ---
CRON_SECRET=                 # cadena larga random; el cron la manda como Bearer
REMINDER_LEAD_MINUTES=30

# --- MercadoPago (Pieza 5) ---
MP_ACCESS_TOKEN=             # SECRETO (arrancar con credenciales de TEST)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=           # opcional, validar webhooks

# --- Mapas ---
# Leaflet + OpenStreetMap no necesita API key.
